PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
EMAIL_USER=

# Database trên cùng cluster. Không đặt → dùng database trong MONGODB_URI (production: "test").
# `npm run dev` tự dùng realestate_dev (xem nodemon.json). Sao chép dữ liệu: node scripts/copy-db.js
MONGODB_DB_NAME=
# Giới hạn request chung cho /api (mặc định 300 / phút / IP)
API_RATE_LIMIT=
# Database cho `npm test` (phải bắt đầu bằng realestate_test hoặc realestate_ci; bị xóa sau mỗi lần chạy)
TEST_DB_NAME=realestate_test

# AI (tùy chọn)
OPENAI_API_KEY=
# Không đặt thì dùng mặc định: gpt-5.4-mini / text-embedding-3-small / reasoning "none"
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_REASONING_EFFORT=
# Model cho AI kiểm duyệt / AI viết tin (mặc định bằng OPENAI_CHAT_MODEL, phải đọc được ảnh)
OPENAI_MODERATION_MODEL=
OPENAI_LISTING_MODEL=
# Đặt false để tắt toàn bộ AI; số câu chatbot/ngày cho người đăng nhập (mặc định 100)
AI_ENABLED=
AI_USER_DAILY_LIMIT=
